{
  "name": "moneymate",
  "productName": "MoneyMate",
  "version": "1.3.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "build-installer": "electron-builder --win"
  },
  "keywords": [],
  "author": "ASUS",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-squirrel-startup": "^1.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.moneymate.app",
    "productName": "MoneyMate",
    "win": {
      "target": "nsis",
      "icon": "images/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "installerHeaderIcon": "images/logo.ico",
      "installerIcon": "images/logo.ico",
      "uninstallerIcon": "images/logo.ico",
      "license": "LICENSE.txt",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "files": [
      ".vite/**/*",
      "images/**/*",
      "package.json",
      "LICENSE.txt"
    ]
  }
}
